#!/usr/bin/env bash
# Runs the [tools] guards before .mise.toml or mise.lock can reach a commit.
#
# Not enabled by cloning. Link it into this repository's hooks directory once:
#
#   ln -sf "$(git rev-parse --show-toplevel)/.githooks/pre-commit" \
#          "$(git rev-parse --git-common-dir)/hooks/pre-commit"
#
# Do NOT set core.hooksPath to .githooks instead. This machine's global
# core.hooksPath points at the dispatcher in .dotfiles/git-hooks, and a
# repository-level setting replaces it rather than adding to it — the worktree
# trust step would stop running here. The dispatcher forwards to
# <git-common-dir>/hooks/pre-commit, which is what the symlink above provides.
#
# The same script runs in CI (.github/workflows/quality.yml), so this hook only
# moves the failure earlier; it is not the only thing enforcing it.

set -euo pipefail

repo="$(git rev-parse --show-toplevel)"

# Nothing staged that these tests cover. The profile fragments are covered too:
# what a profile may disable is decided by what .mise.toml declares, so either
# side moving alone is what the test exists to catch.
if ! git diff --cached --name-only | grep -qE '^(\.mise\.toml|\.mise\.[^.]+\.toml|mise\.lock)$'; then
    exit 0
fi

# Test what is being committed, not what happens to be in the working tree —
# otherwise an unstaged edit either masks a broken commit or fails a fine one.
staged="$(mktemp -d)"
trap 'rm -rf "$staged"' EXIT
git show :.mise.toml > "$staged/.mise.toml"
git show :mise.lock > "$staged/mise.lock"

# The profile fragments as the index has them. A fragment deleted in this commit
# is gone from the index and so leaves no file here, which is exactly right: the
# test globs for what is present and judges that.
while IFS= read -r fragment; do
    git show ":$fragment" > "$staged/$fragment"
done < <(git ls-files -- '.mise.*.toml')

# The documented-coverage check reads the supply-chain pages, so take those from
# the index too and judge one consistent snapshot. A page missing from the index
# leaves no file behind, and the test skips that page rather than failing.
mkdir -p "$staged/docs"
for doc in docs/supply-chain.md docs/supply-chain.ja.md; do
    git show ":$doc" > "$staged/$doc" 2>/dev/null || rm -f "$staged/$doc"
done

bash "$repo/tests/mise-pins-test.sh" "$staged"
